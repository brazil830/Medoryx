# MedOryx-India Environment Configuration Example

# Authoritative Application State Database
# Supports PostgreSQL in production / Docker, and SQLite local file fallback
# For zero-config local development without Docker, SQLite is enabled:
DATABASE_URL=sqlite:///./medoryx.db
# To use PostgreSQL (e.g. Docker Compose or local PostgreSQL service):
# DATABASE_URL=postgresql://medoryxuser:medoryxpassword@localhost:5432/medoryx

# Deterministic Clock Configuration (Part AM)
DEMO_DETERMINISTIC=true
DEMO_DATE=2026-09-30

# Google AI Services (Optional: Graceful deterministic fallback active when omitted)
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
