.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env
!*.env.example
*.pem
*.key
credentials.json
service_account*.json

# Node.js & Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js

# Next.js & Frontend Build Outputs
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
*.tsbuildinfo

# Python & Virtual Environments
__pycache__/
backend/**/__pycache__/
engine/**/__pycache__/
tests/**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/

# Databases & Runtime State
*.db
*.sqlite
*.sqlite3
resilhealth.db
backend/resilhealth.db
medoryx.db
backend/medoryx.db

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Antigravity IDE & Scratch
.agents/
